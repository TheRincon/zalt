#!/usr/bin/env bash
#
# Pre-push validation.
#
# Runs `just pre-push`, which mirrors .github/workflows/ci.yml. The point is to
# find in two minutes on a laptop what would otherwise be found in ten in CI,
# on a branch someone else may already have pulled.
#
# Lives in `ci/hooks/` rather than `.git/hooks/` so it is version-controlled and
# reviewable like the rest of `ci/`. Activate with `just hooks-install`, which
# sets `core.hooksPath` — a per-clone setting, so a fresh clone has no hooks
# until it is run.
#
# To bypass, deliberately:
#
#   git push --no-verify          # git's own escape hatch
#   ZALT_SKIP_HOOKS=1 git push    # same, without forgetting which flag it is
#
# Both are fine. A hook that cannot be skipped gets uninstalled instead.

set -uo pipefail

if [ "${ZALT_SKIP_HOOKS:-0}" = "1" ]; then
    echo "pre-push: skipped (ZALT_SKIP_HOOKS=1)"
    exit 0
fi

# ---------------------------------------------------------------------------
# Deleting a remote branch runs no code, so it should not run a test suite.
#
# git feeds this hook one line per ref: `<local-ref> <local-sha> <remote-ref>
# <remote-sha>`, and an all-zero local sha means "delete this remote ref". If
# every line is a deletion there is nothing to validate.
# ---------------------------------------------------------------------------
have_update=0
saw_ref=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "${local_sha:-}" ] && continue
    saw_ref=1
    case "${local_sha}" in
        *[!0]*) have_update=1 ;;
    esac
done

if [ "${saw_ref}" -eq 0 ]; then
    echo "pre-push: no refs to push, nothing to validate"
    exit 0
fi

if [ "${have_update}" -eq 0 ]; then
    echo "pre-push: deletions only, nothing to validate"
    exit 0
fi

# ---------------------------------------------------------------------------
# `just` must be found, and the hook must fail closed if it is not.
#
# Hooks do not always inherit an interactive shell's PATH — a GUI git client can
# invoke this with little more than /usr/bin. A hook that silently passes when
# its tools are missing is worse than no hook, because it reports success it
# never checked.
# ---------------------------------------------------------------------------
if ! command -v just >/dev/null 2>&1; then
    for candidate in /opt/homebrew/bin /usr/local/bin "$HOME/.cargo/bin"; do
        if [ -x "${candidate}/just" ]; then
            PATH="${candidate}:${PATH}"
            export PATH
            break
        fi
    done
fi

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: FAILED — 'just' not on PATH, so nothing was validated." >&2
    echo "  install:  cargo install just   (or: brew install just)" >&2
    echo "  bypass:   ZALT_SKIP_HOOKS=1 git push" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# A pre-push hook validates the *working tree*, not the commits being pushed.
#
# Usually the same thing; not always. Warn rather than fail — refusing to push
# because of an unrelated dirty file would be its own kind of wrong — but say
# so, because "the thing measured is not the thing shipped" is a mistake this
# project has made in other forms.
# ---------------------------------------------------------------------------
if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    echo "pre-push: NOTE — working tree is dirty."
    echo "          Validating the tree on disk, which is not exactly what you"
    echo "          are pushing."
fi

echo "pre-push: running 'just pre-push'..."
echo

if ! just pre-push; then
    echo >&2
    echo "pre-push: FAILED — push aborted." >&2
    echo "  re-run:   just pre-push" >&2
    echo "  bypass:   git push --no-verify" >&2
    exit 1
fi

exit 0
